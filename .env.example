# ==== Gemini (Google AI Studio) ====
GEMINI_API_KEY=
# Model dung cho OCR anh (ho tro chu viet tay tot)
GEMINI_MODEL=gemini-2.5-flash

# ==== Google Sheets ====
# Duong dan file JSON service account (Google Cloud) co quyen Editor tren Sheet dich
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
# ID cua Google Sheet (lay tu URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_LICENSE=GPLX
GOOGLE_SHEET_TAB_INSURANCE=BaoHiem

# ==== Zalo (tai khoan ca nhan cua Admin) ====
# Thu muc luu session dang nhap Zalo (cookie) de khong phai quet QR lai moi lan chay
ZALO_SESSION_DIR=./zalo-session

# ==== SQLite ====
DATABASE_FILE=./data/ocr-security.sqlite3

# ==== Han muc mac dinh ====
# Han muc OCR toan cong ty theo thang (so luot)
COMPANY_MONTHLY_QUOTA=1000
# Han muc OCR mac dinh cho 1 NVKD moi khi tu dong dang ky (so luot/thang)
DEFAULT_EMPLOYEE_MONTHLY_QUOTA=50

# ==== Admin ====
# Danh sach zalo_id cua admin (phan tach boi dau phay) - co quyen tra soat han muc toan cong ty, cap/sua han muc
ADMIN_ZALO_IDS=

LOG_LEVEL=info
