# Cau hinh ha tang (khong doi luc chay). Cau hinh nghiep vu (Gemini API key, Google Sheets,
# han muc, danh sach NVKD/Admin, dang nhap Zalo) duoc thiet lap qua trang Admin sau khi chay app.

# Cong chay trang Admin
PORT=4000

# Tai khoan dang nhap trang Admin (HTTP Basic Auth).
# De trong ADMIN_PANEL_PASSWORD = KHONG yeu cau dang nhap, ai co duong dan cung vao duoc trang Admin
# (chi nen dung tam thoi khi chay o may ca nhan/mang noi bo). Dien mat khau vao de bat lai dang nhap.
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=

# Noi luu database SQLite (han muc, NVKD, cau hinh, nhat ky OCR)
DATABASE_FILE=./data/ocr-security.sqlite3

# Noi luu session dang nhap Zalo (tranh phai quet QR lai moi lan chay)
ZALO_SESSION_DIR=./zalo-session

LOG_LEVEL=info
